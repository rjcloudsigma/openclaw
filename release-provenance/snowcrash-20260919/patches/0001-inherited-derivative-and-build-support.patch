+test("R2 detached generation covers insert move remove terminal and endedAt without unchanged enumeration", async () => {
+  await withSingleRowCacheStore(
+    "r2-generation-",
+    "/tmp/r2-generation",
+    async ({ now, storePath }) => {
+      const parent = "agent:main:main",
+        child = "agent:main:subagent:r2";
+      await saveSessionStore(storePath, {
+        [parent]: { sessionId: "p", updatedAt: now },
+      });
+      const check = () => {
+        const detached = loadDetachedSessionEntry(parent),
+          ordinary = loadSessionEntry(parent);
+        expect(
+          buildGatewaySessionInfo({ ...detached, key: parent, now })
+            .childSessions,
+        ).toEqual(
+          buildGatewaySessionInfo({ ...ordinary, key: parent, now })
+            .childSessions,
+        );
+        return detached;
+      };
+      check();
+      const write = (fn: (s: Record<string, SessionEntry>) => void) =>
+        updateSessionStore(storePath, fn, {
+          takeCacheOwnership: true,
+          skipMaintenance: true,
+        });
+      await write((s) => {
+        s[child] = { sessionId: "c", updatedAt: now, spawnedBy: parent };
+      });
+      expect(check().childSessionCandidates[child]).toBeDefined();
+      const projection = check().childSessionCandidates;
+      const entries = vi.spyOn(Object, "entries");
+      for (let i = 0; i < 25; i++) {
+        const detached = loadDetachedSessionEntry(parent);
+        expect(detached.childSessionCandidates).toBe(projection);
+      }
+      // No row enumeration of the cached full store (identified by parent row).
+      expect(
+        entries.mock.calls.filter(
+          ([s]) => s && Object.hasOwn(s, parent) && Object.hasOwn(s, child),
+        ).length,
+      ).toBe(0);
+      entries.mockRestore();
+      await write((s) => {
+        s[child].status = "done";
+        s[child].updatedAt = 1;
+      });
+      expect(check().childSessionCandidates[child].status).toBe("done");
+      await write((s) => {
+        s[child].status = undefined;
+        s[child].endedAt = 1;
+      });
+      expect(check().childSessionCandidates[child].endedAt).toBe(1);
+      await write((s) => {
+        s[child].spawnedBy = "agent:main:other";
+      });
+      check();
+      await write((s) => {
+        delete s[child];
+      });
+      expect(check().childSessionCandidates[child]).toBeUndefined();
+    },
+  );
+});
