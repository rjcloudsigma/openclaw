+/** Detached single-session data. No borrowed view survives this synchronous call.
+ * Key selection shares the canonical/legacy/global resolver with ordinary loads.
+ * Child links are projected separately, without cloning unrelated prompt payloads.
+ */
+const detachedChildProjectionCache = new WeakMap<
+  object,
+  { generation: number; store: Record<string, SessionEntry> }
+>();
+
+export function loadDetachedSessionEntry(sessionKey: string, opts?: { agentId?: string }) {
+  const cfg = getRuntimeConfig();
+  const target = resolveGatewaySessionStoreTargetWithStore({
+    cfg,
+    key: normalizeOptionalString(sessionKey) ?? "",
+    agentId: opts?.agentId,
+    keyed: true,
+  });
+  const match = resolveFreshestSessionStoreMatchFromStoreKeys(target.store, target.storeKeys);
+  const view = openSessionEntryReadView({ storePath: target.storePath });
+  let projection = detachedChildProjectionCache.get(view.snapshotToken);
+  if (!projection || projection.generation !== view.snapshotGeneration) {
+    const childStore: Record<string, SessionEntry> = Object.create(null);
+    for (const { sessionKey: key, entry } of view.entries()) {
+      if (entry.spawnedBy || entry.parentSessionKey) {
+        childStore[key] = {
+          sessionId: entry.sessionId,
+          updatedAt: entry.updatedAt,
+          spawnedBy: entry.spawnedBy,
+          parentSessionKey: entry.parentSessionKey,
+          status: entry.status,
+          endedAt: entry.endedAt,
+          startedAt: entry.startedAt,
+        };
+      }
+    }
+    for (const entry of Object.values(childStore)) Object.freeze(entry);
+    projection = {
+      generation: view.snapshotGeneration,
+      store: Object.freeze(childStore),
+    };
+    detachedChildProjectionCache.set(view.snapshotToken, projection);
+  }
+  // Scalar-only detached candidates: visibility is evaluated after handler awaits.
+  return {
+    cfg,
+    ...target,
+    entry: match?.entry,
+    childSessionCandidates: projection.store,
   };
 }
 
