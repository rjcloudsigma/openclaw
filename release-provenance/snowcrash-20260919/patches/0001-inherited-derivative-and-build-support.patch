+// Opt-in output relocation only: keep the production compiler graphs intact.
+import fs from "node:fs";
+import path from "node:path";
+
+function within(parent, child) {
+  const relative = path.relative(parent, child);
+  return (
+    relative === "" ||
+    (!relative.startsWith(`..${path.sep}`) && relative !== ".." && !path.isAbsolute(relative))
+  );
+}
+
+function safeRelative(value) {
+  return (
+    typeof value === "string" &&
+    value.length > 0 &&
+    !path.isAbsolute(value) &&
+    !value.includes("\\") &&
+    !value.includes("\0") &&
+    value.split("/").every((part) => part && part !== "." && part !== "..")
+  );
+}
+
+/** Validate without creating anything. The immediate parent must already exist and be private. */
+export function validateStagingRoot(root, checkout) {
+  if (
+    typeof root !== "string" ||
+    !path.isAbsolute(root) ||
+    root !== path.normalize(root) ||
+    root.endsWith(path.sep) ||
+    root.includes("\\") ||
+    root.includes("\0")
+  ) {
+    throw new Error("Staging root must be a canonical absolute fresh path");
+  }
+  const checkoutRoot = fs.realpathSync(checkout);
+  if (within(checkoutRoot, root) || within(root, checkoutRoot)) {
+    throw new Error("Staging root must be outside the checkout and its parents");
+  }
+  let current = path.parse(root).root;
+  const parts = root.slice(current.length).split(path.sep);
+  for (const [index, part] of parts.entries()) {
+    if (["dist", "dist-runtime", "packages", "node_modules"].includes(part)) {
+      throw new Error("Staging root collides with a package/output path");
+    }
+    current = path.join(current, part);
+    let stat;
+    try {
+      stat = fs.lstatSync(current);
+    } catch (error) {
+      if (error.code !== "ENOENT") throw error;
+      if (index !== parts.length - 1) throw new Error("Staging parent must already exist");
+      return root;
+    }
+    if (stat.isSymbolicLink()) throw new Error("Staging ancestry must not contain symlinks");
+    if (index === parts.length - 1) throw new Error("Staging root/output already exists");
+    if (!stat.isDirectory()) throw new Error("Staging ancestry must contain directories");
+    if (
+      fs.existsSync(path.join(current, "package.json")) ||
+      fs.existsSync(path.join(current, ".git"))
+    ) {
+      throw new Error("Staging ancestry must not contain a package or checkout");
+    }
+    if ((stat.mode & 0o022) !== 0 && (stat.mode & 0o1000) === 0) {
+      throw new Error("Staging ancestry must not be writable by other users");
+    }
+    if (
+      index === parts.length - 2 &&
+      ((stat.mode & 0o022) !== 0 || (process.getuid && stat.uid !== process.getuid()))
+    ) {
+      throw new Error("Staging parent must be owned by the current user and private");
+    }
+  }
+  throw new Error("Invalid staging root");
+}
+
+/** No entry-subset API: dynamic runtime boundaries cannot be inferred from an import seed list. */
+export function stageTsdownConfigs(configs, { env = process.env, checkout = process.cwd() } = {}) {
+  const root = env.OPENCLAW_BUILD_STAGING_ROOT;
+  const entries = env.OPENCLAW_BUILD_STAGING_ENTRIES;
+  if (root === undefined && entries === undefined) return configs;
+  if (entries !== undefined && entries !== "full") {
+    throw new Error(
+      "Unsupported staging entries: only full is supported (no arbitrary/partial entries)",
+    );
+  }
+  if (root === undefined) throw new Error("Staging entries require OPENCLAW_BUILD_STAGING_ROOT");
+  if (env.OPENCLAW_BUNDLED_PLUGIN_BUILD_IDS !== undefined) {
+    throw new Error(
+      "Staging requires the full production graph; bundled plugin subsets are not qualified",
+    );
+  }
+  validateStagingRoot(root, checkout);
+  const outputs = [];
+  return configs.map((config) => {
+    const output = config.outDir ?? "dist";
+    if (!safeRelative(output) || !(output === "dist" || /^packages\/[^/]+\/dist$/u.test(output))) {
+      throw new Error(`Unsupported staging output: ${output}`);
+    }
+    if (outputs.some((previous) => within(previous, output) || within(output, previous))) {
+      throw new Error(`Overlapping staging outputs: ${output}`);
+    }
+    outputs.push(output);
+    if (
+      !config.entry ||
+      Array.isArray(config.entry) ||
+      typeof config.entry !== "object" ||
+      Object.keys(config.entry).some((key) => !safeRelative(key))
+    ) {
+      throw new Error("Staging requires production entry maps with safe output names");
+    }
+    return { ...config, outDir: path.join(root, output) };
+  });
+}
