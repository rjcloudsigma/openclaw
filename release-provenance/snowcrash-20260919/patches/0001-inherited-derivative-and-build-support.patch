+      "src/agents/db-owner-review.test.ts",
+      "src/gateway/session-utils.detached-resolvers-r2.test.ts",
+      "src/gateway/server-methods/chat.detached-r2.test.ts",
+      "src/agents/subagent-registry-state.test.ts",
+      "src/agents/subagent-registry.store.sqlite.test.ts",
+      "src/gateway/session-utils.single-row-cache.test.ts",
+      "src/gateway/session-utils.test.ts",
+      "src/gateway/session-utils.plugin-runtime.test.ts",
+    ],
+    maxWorkers: 1,
+    fileParallelism: false,
+  },
