+import { defineConfig } from "vitest/config";
+import path from "node:path";
+import fs from "node:fs";
+const alias = fs.readdirSync("packages").flatMap((name) => {
+  const root = path.resolve("packages", name, "src");
+  return [
+    {
+      find: new RegExp("^@openclaw/" + name + "/(.+)$"),
+      replacement: root + "/$1.ts",
+    },
+    { find: "@openclaw/" + name, replacement: root + "/index.ts" },
+  ];
+});
+export default defineConfig({
+  resolve: {
+    alias: [
+      ...Object.entries(
+        JSON.parse(fs.readFileSync("tsconfig.json", "utf8")).compilerOptions
+          .paths,
+      )
+        .filter(([key]) => !key.includes("*"))
+        .map(([find, targets]) => ({
+          find: new RegExp("^" + find + "$"),
+          replacement: path.resolve((targets as string[])[0]),
+        })),
+      ...alias,
+      {
+        find: /^openclaw\/plugin-sdk\/(.+)$/,
+        replacement: path.resolve("src/plugin-sdk") + "/$1.ts",
+      },
+    ],
+  },
+  test: {
