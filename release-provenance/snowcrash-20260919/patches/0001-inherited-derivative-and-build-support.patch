+import { spawnSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import { stageTsdownConfigs, validateStagingRoot } from "../../scripts/lib/tsdown-staging.mjs";
+import configs from "../../tsdown.config.ts";
+
+const parent = fs.mkdtempSync(path.join(fs.realpathSync(os.tmpdir()), "tsdown-stage-test-"));
+const root = path.join(parent, "fresh");
+const checkout = process.cwd();
+const env = { OPENCLAW_BUILD_STAGING_ROOT: root };
+afterAll(() => fs.rmSync(parent, { recursive: true, force: true }));
+
+describe("staged production config (evaluation only)", () => {
+  it("is an identity operation by default", () => {
+    expect(stageTsdownConfigs(configs, { env: {} })).toBe(configs);
+  });
+  it("relocates every disjoint output, preserving the complete graph and all options", () => {
+    const staged = stageTsdownConfigs(configs, { env });
+    expect(staged).toHaveLength(configs.length);
+    expect(new Set(staged.map((c) => c.outDir)).size).toBe(configs.length);
+    staged.forEach((c, i) => {
+      expect(c.outDir).toBe(path.join(root, configs[i].outDir ?? "dist"));
+      const { outDir: _a, ...actual } = c;
+      const { outDir: _b, ...original } = configs[i];
+      expect(actual).toEqual(original);
+      expect(c.entry).toBe(configs[i].entry);
+      expect(c.inputOptions).toBe(configs[i].inputOptions);
+      expect(c.deps).toBe(configs[i].deps);
+    });
+    expect(fs.existsSync(root)).toBe(false);
+  });
+  it("retains dynamic host boundaries, SDK/plugin singletons and all workspace exports", () => {
+    const staged = stageTsdownConfigs(configs, { env });
+    const unified = staged.find((c) => c.outDir === path.join(root, "dist"))!;
+    for (const key of [
+      "plugins/loader",
+      "plugins/sdk-alias",
+      "plugins/runtime/index",
+      "plugins/hook-runner-global",
+      "plugins/memory-state",
+      "agents/model-catalog.runtime",
+      "plugins/provider-runtime.runtime",
+      "memory-core-local-embedding-worker",
+      "plugin-sdk/plugin-entry",
+      "plugin-sdk/state-paths",
+      "plugin-sdk/routing",
+      "extensions/scoped-vault/index",
+    ]) {
+      expect(unified.entry).toHaveProperty(key);
+    }
+    for (const original of configs.filter((c) => c.outDir)) {
+      expect(staged.find((c) => c.outDir === path.join(root, original.outDir!))?.entry).toEqual(
+        original.entry,
+      );
+    }
+  });
+  it.each(["plugins/loader", "unknown", "../evil.ts", "/tmp/evil.mjs", "", "full,plugins/loader"])(
+    "rejects incomplete or unknown entries %s",
+    (entries) => {
+      expect(() =>
+        stageTsdownConfigs(configs, { env: { ...env, OPENCLAW_BUILD_STAGING_ENTRIES: entries } }),
+      ).toThrow(/only full/);
+    },
+  );
+  it("requires a root and refuses inherited plugin subset selectors", () => {
+    expect(() =>
+      stageTsdownConfigs(configs, { env: { OPENCLAW_BUILD_STAGING_ENTRIES: "full" } }),
+    ).toThrow(/require/);
+    expect(() =>
+      stageTsdownConfigs(configs, {
+        env: { ...env, OPENCLAW_BUNDLED_PLUGIN_BUILD_IDS: "scoped-vault" },
+      }),
+    ).toThrow(/full production/);
+    expect(
+      stageTsdownConfigs(configs, { env: { ...env, OPENCLAW_BUILD_STAGING_ENTRIES: "full" } }),
+    ).toHaveLength(configs.length);
+  });
+  it.each([
+    "",
+    "relative",
+    "/",
+    checkout,
+    path.dirname(checkout),
+    `${checkout}/new-stage`,
+    `${root}/../escape`,
+    `${root}/`,
+    `${parent}/node_modules/new`,
+    `${parent}/dist/new`,
+    `${parent}/packages/new`,
+    `${parent}/missing/new`,
+  ])("rejects unsafe root %s", (invalid) => {
+    expect(() => validateStagingRoot(invalid, checkout)).toThrow();
+  });
+  it("rejects existing outputs, symlink ancestry (including dangling links), and package ancestry", () => {
+    const existing = path.join(parent, "existing");
+    fs.mkdirSync(existing);
+    expect(() => validateStagingRoot(existing, checkout)).toThrow(/already exists/);
+    const link = path.join(parent, "link");
+    fs.symlinkSync(checkout, link);
+    expect(() => validateStagingRoot(`${link}/new`, checkout)).toThrow(/symlinks/);
+    const dangling = path.join(parent, "dangling");
+    fs.symlinkSync(path.join(parent, "absent"), dangling);
+    expect(() => validateStagingRoot(dangling, checkout)).toThrow(/symlinks/);
+    const pkg = path.join(parent, "pkg");
+    fs.mkdirSync(pkg);
+    fs.writeFileSync(path.join(pkg, "package.json"), "{}");
+    expect(() => validateStagingRoot(`${pkg}/new`, checkout)).toThrow(/package/);
+    const shared = path.join(parent, "shared");
+    fs.mkdirSync(shared);
+    fs.chmodSync(shared, 0o777);
+    expect(() => validateStagingRoot(`${shared}/new`, checkout)).toThrow(/writable|private/);
+  });
+  it("fails closed on output traversal, absolute output, overlaps and entry traversal", () => {
+    for (const outDir of ["../escape", "/tmp/escape", "packages/../dist", "other"]) {
